TAVILY_API_KEY=your_tavily_key
BIFROST_BASE_URL=http://localhost:8080/openai
BIFROST_API_KEY=bifrost
# Use the provider/model names you added inside Bifrost
EXTRACT_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=openai/gpt-4o
# Model used to read images (must support vision). Defaults to JUDGE_MODEL
VISION_MODEL=openai/gpt-4o
# Optional: how many risky claims to check per answer, Tavily depth (basic|advanced)
MAX_CHECK=6
TAVILY_DEPTH=basic
# Optional: restrict Tavily to recent pages (day|week|month|year). Empty = no filter
TAVILY_TIME_RANGE=
# Seconds to wait for one model answer (use 90 on a free Render server)
LLM_TIMEOUT=60
